+package li.joye.yakuyomi.engine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+class ConstructionResourcesTest {
+    @Test fun failedConstructionClosesEveryResourceInReverseOrder() {
+        val closed = mutableListOf<Int>()
+        assertThrows(IllegalArgumentException::class.java) {
+            ConstructionResources().use { resources ->
+                resources.own(AutoCloseable { closed.add(1) })
+                resources.own(AutoCloseable { closed.add(2); error("close failure") })
+                throw IllegalArgumentException("third model failed")
+            }
+        }
+        assertEquals(listOf(2, 1), closed)
+    }
+
+    @Test fun successfulConstructionTransfersOwnership() {
+        val closed = mutableListOf<Int>()
+        ConstructionResources().use { resources ->
+            resources.own(AutoCloseable { closed.add(1) })
+            resources.transfer()
+        }
+        assertEquals(emptyList<Int>(), closed)
+    }
+}
diff --git a/engine/src/test/kotlin/li/joye/yakuyomi/engine/OcrTerminalPunctuationTest.kt b/engine/src/test/kotlin/li/joye/yakuyomi/engine/OcrTerminalPunctuationTest.kt
