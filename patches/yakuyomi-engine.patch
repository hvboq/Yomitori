index 0000000..4535794
--- /dev/null
+++ b/engine/src/test/kotlin/li/joye/yakuyomi/engine/OcrTerminalPunctuationTest.kt
@@ -0,0 +1,129 @@
+package li.joye.yakuyomi.engine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class OcrTerminalPunctuationTest {
+    private val width = 150
+    private val height = 48
+    private val black = 0xff000000.toInt()
+
+    private fun page() = IntArray(width * height) { -1 }.also {
+        // Several full-height strokes represent the preceding body, independently of its text.
+        for (x in listOf(6, 20, 40, 70, 100)) rect(it, x, 7, x + 3, 40)
+    }
+
+    private fun rect(pixels: IntArray, x0: Int, y0: Int, x1: Int, y1: Int, color: Int = black) {
+        for (y in y0..y1) for (x in x0..x1) pixels[y * width + x] = color
+    }
+
+    private fun ring(pixels: IntArray, x: Int = 120, y: Int = 31, color: Int = black) {
+        for (dy in 0..10) for (dx in 0..10) {
+            val r2 = (dx - 5) * (dx - 5) + (dy - 5) * (dy - 5)
+            if (r2 in 12..30) pixels[(y + dy) * width + x + dx] = color
+        }
+    }
+
+    @Test
+    fun detachedLowerRingHasSpatialEvidence() {
+        val pixels = page().also { ring(it) }
+        val circle = OcrTerminalPunctuation.findCircle(pixels, width, height)
+        assertNotNull(circle)
+        assertEquals(112, circle!!.bodyEnd)
+        assertEquals(120, circle.left)
+        assertEquals(31, circle.top)
+    }
+
+    @Test
+    fun upperHandakutenAndFullHeightKanaBodyAreNotFullStops() {
+        for (kana in listOf("は", "ば", "ぱ")) {
+            val pixels = page()
+            ring(pixels, 120, 8)
+            // The same columns also contain the main kana body below the diacritic.
+            rect(pixels, 120, 23, 122, 40)
+            rect(pixels, 120, 35, 130, 38)
+            assertNull(kana, OcrTerminalPunctuation.findCircle(pixels, width, height))
+        }
+        assertNull(OcrTerminalPunctuation.findCircle(page().also { ring(it, y = 8) }, width, height))
+    }
+
+    @Test
+    fun fullHeightTerminalGlyphAndBodyAttachedLoopRemainUnchanged() {
+        val pixels = page().also { ring(it) }
+        rect(pixels, 123, 8, 125, 33)
+        assertNull(OcrTerminalPunctuation.findCircle(pixels, width, height))
+        val attached = page().also { ring(it) }
+        rect(attached, 103, 36, 120, 37)
+        assertNull(OcrTerminalPunctuation.findCircle(attached, width, height))
+    }
+
+    @Test
+    fun solidDotBrokenRingColoredInkAndClippedRingAreAmbiguous() {
+        val solid = page().also { rect(it, 120, 31, 130, 41) }
+        assertNull(OcrTerminalPunctuation.findCircle(solid, width, height))
+        val broken = page().also { ring(it); rect(it, 124, 31, 126, 36, -1) }
+        assertNull(OcrTerminalPunctuation.findCircle(broken, width, height))
+        val colored = page().also { ring(it, color = 0xff600000.toInt()) }
+        assertNull(OcrTerminalPunctuation.findCircle(colored, width, height))
+        val clipped = page().also { ring(it, x = 139) }
+        assertNull(OcrTerminalPunctuation.findCircle(clipped, width, height))
+    }
+
+    @Test
+    fun oneBlankColumnStillRequiresAnIndependentClosedComponent() {
+        val pixels = page().also { ring(it, x = 105) }
+        val circle = OcrTerminalPunctuation.findCircle(pixels, width, height)
+        assertNotNull(circle)
+        assertEquals(width, circle!!.bodyEnd)
+        val erased = OcrTerminalPunctuation.withoutCircle(pixels, circle)
+        val members = circle.componentPixels.toSet()
+        for (i in pixels.indices) assertEquals(if (i in members) -1 else pixels[i], erased[i])
+        // A pale connection to the body is not safely removable even when the black cores separate.
+        rect(pixels, 103, 36, 105, 36, 0xffdddddd.toInt())
+        assertNull(OcrTerminalPunctuation.findCircle(pixels, width, height))
+    }
+
+    @Test
+    fun overlappingColumnsRetainEveryPixelOfTheOtherComponent() {
+        val pixels = page().also {
+            // Upper stroke reaches the same x columns as the lower, disconnected ring.
+            rect(it, 103, 10, 121, 12)
+            ring(it)
+            it[30 * width + 125] = 0xffdddddd.toInt() // Connected antialiasing outside the black core.
+        }
+        val circle = OcrTerminalPunctuation.findCircle(pixels, width, height)
+        assertNotNull(circle)
+        assertEquals(width, circle!!.bodyEnd)
+        val body = OcrTerminalPunctuation.withoutCircle(pixels, circle)
+        assertEquals(-1, body[30 * width + 125])
+        assertEquals(0xffdddddd.toInt(), pixels[30 * width + 125])
+        for (y in 10..12) for (x in 103..121) assertEquals(black, body[y * width + x])
+        val members = circle.componentPixels.toSet()
+        assertTrue(members.isNotEmpty())
+        for (i in pixels.indices) if (i !in members) assertEquals(pixels[i], body[i])
+    }
+
+    @Test
+    fun ringBelowTheBaselineDistantArtAndHollowMusicalNoteAreRejected() {
+        val below = IntArray(width * height) { -1 }
+        for (x in listOf(6, 20, 40, 70, 100)) rect(below, x, 2, x + 3, 28)
+        ring(below, y = 36)
+        assertNull(OcrTerminalPunctuation.findCircle(below, width, height))
+        assertNull(OcrTerminalPunctuation.findCircle(page().also { ring(it, x = 136) }, width, height))
+        val note = page().also { ring(it); rect(it, 129, 8, 130, 36) }
+        assertNull(OcrTerminalPunctuation.findCircle(note, width, height))
+    }
+
+    @Test
+    fun aSecondCtcPassMustAgreeOnEveryBodyCharacter() {
+        assertEquals("まだ準備ができません。", OcrTerminalPunctuation.reconcile("まだ準備ができませんば", "まだ準備ができません"))
+        assertEquals("はばぱ。", OcrTerminalPunctuation.reconcile("はばぱ", "はばぱ"))
+        assertEquals("はばぱ。", OcrTerminalPunctuation.reconcile("はばぱ。", "はばぱ"))
+        assertNull(OcrTerminalPunctuation.reconcile("はばぱ", "はば".replace('ば', 'は')))
+        assertNull(OcrTerminalPunctuation.reconcile("はばぱ", "は"))
+        assertNull(OcrTerminalPunctuation.reconcile("はばぱ", ""))
+    }
+}
