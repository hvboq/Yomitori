@@ -0,0 +1,111 @@
+package li.joye.yakuyomi.engine
+
+import java.text.BreakIterator
+import java.util.Locale
+
+/** Keep platform graphemes intact, including emoji sequences on older Android break iterators. */
+internal fun textClusters(text: String): List<String> {
+    val iterator = BreakIterator.getCharacterInstance(Locale.ROOT).apply { setText(text) }
+    val result = ArrayList<String>()
+    var start = iterator.first()
+    var end = iterator.next()
+    while (end != BreakIterator.DONE) {
+        val cluster = text.substring(start, end)
+        val cp = cluster.codePointAt(0)
+        val type = Character.getType(cp)
+        val extension = type == Character.NON_SPACING_MARK.toInt() ||
+            type == Character.COMBINING_SPACING_MARK.toInt() || type == Character.ENCLOSING_MARK.toInt() ||
+            cp == 0x200D || cp in 0xFE00..0xFE0F || cp in 0xE0100..0xE01EF || cp in 0x1F3FB..0x1F3FF
+        val previous = result.lastOrNull()
+        val flagPair = cp in 0x1F1E6..0x1F1FF && previous != null &&
+            previous.codePointCount(0, previous.length) == 1 && previous.codePointAt(0) in 0x1F1E6..0x1F1FF
+        if (previous != null && (extension || previous.endsWith('\u200D') || flagPair)) {
+            result[result.lastIndex] = previous + cluster
+        } else {
+            result.add(cluster)
+        }
+        start = end
+        end = iterator.next()
+    }
+    return result
+}
+
+internal fun hasHangul(text: String): Boolean = text.any {
+    it.code in 0xAC00..0xD7A3 || it.code in 0x1100..0x11FF || it.code in 0x3130..0x318F ||
+        it.code in 0xA960..0xA97F || it.code in 0xD7B0..0xD7FF
+}
+
+/** Padding must not consume most of a narrow Korean bubble's usable width. */
+internal fun horizontalWrapWidth(width: Float, size: Int, rowTrim: Int): Float =
+    width - minOf(rowTrim.coerceAtLeast(0) * size.toFloat(), width * 0.25f)
+
+/**
+ * Explicit newlines (including empty paragraphs) are retained. Soft-wrap boundary whitespace is
+ * discarded, while every non-whitespace grapheme is retained. Prefer spaces, then legal character
+ * boundaries; an unbreakable grapheme/punctuation group may exceed the width so the fitter rejects it.
+ */
+internal fun wrapTranslation(text: String, maxWidth: Float, measure: (String) -> Float): List<String> {
+    require(maxWidth.isFinite() && maxWidth > 0f)
+    val lines = ArrayList<String>()
+    for (paragraph in text.replace("\r\n", "\n").replace('\r', '\n').split('\n')) {
+        val cells = textClusters(paragraph)
+        if (cells.all { it.isBlank() }) {
+            lines.add("")
+            continue
+        }
+        fun line(from: Int, to: Int) = cells.subList(from, to).joinToString("").trimEnd()
+        fun legal(at: Int): Boolean {
+            var left = at - 1
+            var right = at
+            while (left >= 0 && cells[left].isBlank()) left--
+            while (right < cells.size && cells[right].isBlank()) right++
+            val before = cells.getOrNull(left)?.lastOrNull()
+            val after = cells.getOrNull(right)?.firstOrNull()
+            return (before == null || before !in NO_LINE_END) && (after == null || after !in NO_LINE_START)
+        }
+        var start = 0
+        while (start < cells.size) {
+            while (start < cells.size && cells[start].isBlank()) start++
+            if (start == cells.size) break
+            var end = start
+            while (end < cells.size && measure(line(start, end + 1)) <= maxWidth) end++
+            if (end == cells.size) {
+                lines.add(line(start, end))
+                break
+            }
+            val wordBoundary = (start + 1..end).lastOrNull {
+                cells.getOrNull(it)?.isBlank() == true && legal(it)
+            }
+            val boundary = wordBoundary ?: (end downTo start + 1).firstOrNull(::legal)
+            if (boundary != null) {
+                end = boundary
+            } else {
+                end = maxOf(start + 1, end)
+                while (end < cells.size && !legal(end)) end++
+            }
+            if (wordBoundary == null) {
+                // Only rebalance a forced split of the final Korean word. Never move a complete
+                // word across a preferred space boundary or change an explicit paragraph break.
+                val tailEnd = cells.indexOfLast { !it.isBlank() } + 1
+                val word = cells.subList(start, tailEnd)
+                val koreanWord = word.all { hasHangul(it) || it.all { ch -> ch in NO_LINE_START } }
+                if (koreanWord && cells.subList(end.coerceAtMost(tailEnd), tailEnd).count(::hasHangul) == 1) {
+                    val balanced = (start + 1 until end).filter { split ->
+                        legal(split) && cells.subList(start, split).count(::hasHangul) >= 2 &&
+                            cells.subList(split, tailEnd).count(::hasHangul) >= 2 &&
+                            measure(line(start, split)) <= maxWidth && measure(line(split, tailEnd)) <= maxWidth
+                    }.minByOrNull { split ->
+                        kotlin.math.abs(measure(line(start, split)) - measure(line(split, tailEnd)))
+                    }
+                    if (balanced != null) end = balanced
+                }
+            }
+            lines.add(line(start, end))
+            start = end
+        }
+    }
+    return lines
+}
+
+private const val NO_LINE_START = ",.!?:;%)]}、。，．：；！？”’）〕】｝」』》〉…‥ーゝゞヽヾ々ぁぃぅぇぉっゃゅょゎァィゥェォッャュョヮ"
+private const val NO_LINE_END = "([{‘“（〔【｛「『《〈"
