+package li.joye.yakuyomi.engine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TextWrappingTest {
+    private fun width(text: String) = textClusters(text).size.toFloat()
+    private fun compact(text: String) = text.filterNot(Char::isWhitespace)
+
+    @Test fun narrowBubblePaddingLeavesRoomForSeveralKoreanGlyphs() {
+        assertEquals(60f, horizontalWrapWidth(80f, 20, 3), 0.001f)
+        val lines = wrapTranslation("오늘은 정말 좋은 날이에요.", 3f, ::width)
+        assertTrue(lines.size < compact("오늘은 정말 좋은 날이에요.").length)
+        assertTrue(lines.all { width(it) <= 3f })
+        assertEquals("오늘은정말좋은날이에요.", compact(lines.joinToString("")))
+    }
+
+    @Test fun prefersWordsAndSplitsOnlyOverlongWordsWithoutDroppingText() {
+        assertEquals(listOf("오늘은", "정말", "좋아요"), wrapTranslation("오늘은 정말 좋아요", 5f, ::width))
+        val text = "가나다라마바사아자차 and extraordinarilylongword"
+        val lines = wrapTranslation(text, 5f, ::width)
+        assertEquals(compact(text), compact(lines.joinToString("")))
+        assertTrue(lines.all { width(it) <= 5f })
+    }
+
+    @Test fun punctuationStaysWithItsNeighborEvenAcrossWhitespace() {
+        val samples = listOf("가나다,라마!", "가나(다라)", "가나 ,다라", "가나「다라。」", "정말?! 그래.")
+        for (text in samples) {
+            val lines = wrapTranslation(text, 3f, ::width)
+            assertEquals(compact(text), compact(lines.joinToString("")))
+            assertTrue(lines.all { width(it) <= 3f })
+            assertTrue(lines.none { it.firstOrNull() in listOf(',', '.', '!', '?', ')', '」', '。') })
+            assertTrue(lines.none { it.lastOrNull() in listOf('(', '「') })
+        }
+    }
+
+    @Test fun explicitParagraphsAndBlankLinesRemainButSoftBoundarySpacesAreDiscarded() {
+        assertEquals(listOf("안녕", "", "다음", ""), wrapTranslation("안녕\r\n\r\n다음\n", 8f, ::width))
+        assertEquals(listOf("가나", "다라"), wrapTranslation("  가나   다라  ", 3f, ::width))
+    }
+
+    @Test fun supplementaryCombiningVariationAndZwjSequencesNeverSplit() {
+        val clusters = listOf("😀", "e\u0301", "❤\uFE0F", "👩\u200D💻", "👍🏽", "🇰🇷", "\u1100\u1161")
+        val text = clusters.joinToString("")
+        assertEquals(clusters, textClusters(text))
+        assertEquals(clusters, wrapTranslation(text, 1f, ::width))
+        assertEquals(text, wrapTranslation(text, 2f, ::width).joinToString(""))
+    }
+
+    @Test fun oversizedGraphemeOrPunctuationGroupRemainsWholeForFitterToReject() {
+        assertEquals(listOf("👩\u200D💻"), wrapTranslation("👩\u200D💻", 1f) { 2f })
+        assertEquals(listOf("(가)"), wrapTranslation("(가)", 1f, ::width))
+    }
+
+    @Test fun KoreanDetectionIncludesDecomposedAndCompatibilityJamo() {
+        assertTrue(hasHangul("안녕하세요!"))
+        assertTrue(hasHangul("\u1100\u1161"))
+        assertTrue(hasHangul("ㅋㅋ"))
+        assertFalse(hasHangul("こんにちは Hello"))
+    }
+
+    @Test fun finalForcedKoreanWordSplitAvoidsOneSyllableTailWithinTheSameWidth() {
+        assertEquals(listOf("오늘은", "정말", "좋은", "날이", "에요."), wrapTranslation("오늘은 정말 좋은 날이에요.", 3f, ::width))
+        assertEquals(listOf("가나", "다라"), wrapTranslation("가나다라", 3f, ::width))
+        assertEquals(listOf("가나", "다라!"), wrapTranslation("가나다라!", 3f, ::width))
+        val text = "\u1100\u1161나다라."
+        val lines = wrapTranslation(text, 3f, ::width)
+        assertEquals(listOf("\u1100\u1161나", "다라."), lines)
+        assertEquals(text, lines.joinToString(""))
+        assertTrue(lines.all { width(it) <= 3f })
+    }
+
+    @Test fun balancingDoesNotAlterEnglishWordBoundariesBlankParagraphsOrImpossibleWidths() {
+        assertEquals(listOf("abc", "d."), wrapTranslation("abcd.", 3f, ::width))
+        assertEquals(listOf("가나다", "라."), wrapTranslation("가나다 라.", 3f, ::width))
+        assertEquals(listOf("가나다", "", "라."), wrapTranslation("가나다\n\n라.", 3f, ::width))
+        assertEquals(listOf("가나", "다라", "마."), wrapTranslation("가나다라마.", 2f, ::width))
+        assertEquals(listOf("가나👩\u200D💻", "라."), wrapTranslation("가나👩\u200D💻라.", 3f, ::width))
+    }
+}
