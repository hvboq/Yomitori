@@ -0,0 +1,113 @@
+package li.joye.yakuyomi.engine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class BubbleReflowTest {
+    private val left = PixelBounds(20, 20, 190, 260)
+    private val right = PixelBounds(250, 20, 420, 260)
+    private val columns = listOf(
+        ReflowColumn(0, PixelBounds(120, 60, 150, 200), "잠시만 기다려"),
+        ReflowColumn(1, PixelBounds(70, 60, 100, 180), "주세요"),
+        ReflowColumn(2, PixelBounds(350, 60, 380, 230), "내일도 잘"),
+        ReflowColumn(3, PixelBounds(300, 60, 330, 210), "부탁드립니다"),
+    )
+    private fun contains(a: PixelBounds, b: PixelBounds) =
+        b.left >= a.left && b.right <= a.right && b.top >= a.top && b.bottom <= a.bottom
+    private fun intersects(a: PixelBounds, b: PixelBounds) =
+        a.left < b.right && b.left < a.right && a.top < b.bottom && b.top < a.bottom
+    private fun plan(
+        input: List<ReflowColumn> = columns,
+        bubbles: List<PixelBounds> = listOf(left, right),
+        other: Map<Int, PixelBounds> = emptyMap(),
+        art: List<PixelBounds> = emptyList(),
+    ) = planBubbleReflow(input, input.associate { it.index to it.bounds } + other, 460, 300) { box ->
+        bubbles.any { contains(it, box) } && art.none { intersects(it, box) }
+    }
+
+    @Test fun combinesOnlyColumnsInTheSameClearEnclosedBandInRightToLeftOrder() {
+        val plans = plan()
+        assertEquals(2, plans.size)
+        val first = plans.single { 0 in it.members }
+        val second = plans.single { 2 in it.members }
+        assertEquals(setOf(0, 1), first.members)
+        assertEquals("잠시만 기다려 주세요", first.text)
+        assertEquals(setOf(2, 3), second.members)
+        assertEquals("내일도 잘 부탁드립니다", second.text)
+        assertTrue(contains(left, first.bounds))
+        assertTrue(contains(right, second.bounds))
+        assertTrue(first.bounds.width > 4 * columns[0].bounds.width)
+        assertTrue(!intersects(first.bounds, second.bounds))
+    }
+
+    @Test fun closeColumnsSeparatedByABalloonWallAreNeverMerged() {
+        val input = listOf(
+            ReflowColumn(0, PixelBounds(80, 60, 110, 200), "첫 대사"),
+            ReflowColumn(1, PixelBounds(145, 60, 175, 200), "다른 대사"),
+        )
+        val plans = plan(input, listOf(PixelBounds(20, 20, 125, 260), PixelBounds(130, 20, 230, 260)))
+        assertEquals(2, plans.size)
+        assertTrue(plans.all { it.members.size == 1 })
+        assertTrue(!intersects(plans[0].bounds, plans[1].bounds))
+    }
+
+    @Test fun protectedOrOtherTranslationBetweenColumnsPreventsExpansionAcrossIt() {
+        val obstacle = PixelBounds(106, 50, 116, 220)
+        assertTrue(plan(columns.take(2), other = mapOf(99 to obstacle)).isEmpty())
+    }
+
+    @Test fun anOverlappingOriginalRegionPreventsReflowEvenOnWhitePixels() {
+        val obstacle = PixelBounds(125, 70, 140, 110)
+        assertTrue(plan(listOf(columns[0]), other = mapOf(99 to obstacle)).isEmpty())
+    }
+
+    @Test fun openWhitePageAndDarkOrUncertainBackgroundsUseOriginalLayout() {
+        assertTrue(plan(columns.take(2), bubbles = listOf(PixelBounds(0, 0, 460, 300))).isEmpty())
+        assertTrue(plan(columns.take(2), bubbles = emptyList()).isEmpty())
+        assertTrue(plan(columns.take(2), art = columns.take(2).map { it.bounds }).isEmpty())
+    }
+
+    @Test fun artworkWithinTheSearchBandIsNeverInsideTheChosenArea() {
+        val art = PixelBounds(40, 80, 60, 100)
+        val plans = plan(columns.take(2), art = listOf(art))
+        assertTrue(plans.isNotEmpty())
+        assertTrue(plans.none { intersects(it.bounds, art) })
+    }
+
+    @Test fun reflowPreservesAllTranslatedContentIncludingExplicitParagraphsAndEmoji() {
+        val first = columns[0].copy(text = "안녕\n\n👩‍💻")
+        val second = columns[1].copy(text = "좋아요 ❤️")
+        val plans = plan(listOf(first, second))
+        assertEquals("안녕\n\n👩‍💻 좋아요 ❤️", plans.single().text)
+        assertEquals("안녕\n\n👩‍💻", first.text)
+        assertEquals("좋아요 ❤️", second.text)
+    }
+
+    @Test fun ovalBalloonUsesWiderMiddleButEveryChosenPixelRemainsClear() {
+        val source = ReflowColumn(0, PixelBounds(134, 78, 166, 222), "……너는,")
+        fun clear(box: PixelBounds): Boolean = (box.top until box.bottom).all { y ->
+            (box.left until box.right).all { x ->
+                val dx = (x - 150.0) / 95.0
+                val dy = (y - 150.0) / 100.0
+                dx * dx + dy * dy < 1.0
+            }
+        }
+        val area = planBubbleReflow(listOf(source), mapOf(0 to source.bounds), 300, 300, ::clear).single()
+        assertTrue(area.bounds.width > 140)
+        assertTrue(area.bounds.top > source.bounds.top)
+        assertTrue(area.bounds.bottom < source.bounds.bottom)
+        assertTrue(clear(area.bounds))
+        assertEquals(source.text, area.text)
+    }
+
+    @Test fun shorterBandsCannotBypassArtworkOrProtectedPixelsInsideTheOriginalSourceBox() {
+        val source = ReflowColumn(0, PixelBounds(100, 60, 173, 158), "네, 아버님")
+        val bubble = PixelBounds(50, 20, 230, 230)
+        assertTrue(plan(listOf(source), listOf(bubble)).isNotEmpty())
+        // A narrow centre band could omit this top corner; source evidence still must be clear.
+        val corner = PixelBounds(105, 62, 115, 72)
+        assertTrue(plan(listOf(source), listOf(bubble), art = listOf(corner)).isEmpty())
+        assertTrue(plan(listOf(source), listOf(bubble), other = mapOf(99 to corner)).isEmpty())
+    }
+}
