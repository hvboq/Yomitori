+                    if (nx !in 0 until width || ny !in 0 until height) continue
+                    val next = ny * width + nx
+                    if (visited[next]) continue
+                    visited[next] = true
+                    val p = pixels[next]
+                    if (((p ushr 16) and 255) < threshold && ((p ushr 8) and 255) < threshold && (p and 255) < threshold) {
+                        if (count == queue.size) return null
+                        queue[count++] = next
+                    }
+                }
+            }
+            return queue.copyOf(count)
+        }
