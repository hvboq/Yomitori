+        var bodyRight = -1
+        for (x in 0 until width) for (y in 0 until height) if (dark(x, y) && y * width + x !in coreSet) {
+            bodyTop = minOf(bodyTop, y); bodyBottom = maxOf(bodyBottom, y)
+            bodyRight = maxOf(bodyRight, x)
+        }
+        if (bodyBottom - bodyTop + 1 < height * 0.55f || kotlin.math.abs(bottom - bodyBottom) > height * 0.15f) return null
+        // A terminal mark must be beside the body, not a ring below/above it or distant decoration.
+        if (bodyRight < height / 2 || bodyRight > left + cw / 4 || left - bodyRight > height * 0.6f) return null
+
+        // Require a single connected outline, with a genuinely enclosed white centre. A comma,
+        // filled dot, broken/clipped circle or unrelated detached strokes do not qualify.
+        val queue = IntArray(cw * ch)
+        var count = 0
+        var head = 0
+        val exterior = BooleanArray(cw * ch)
+        count = 0; head = 0
+        fun enqueue(x: Int, y: Int) {
+            if (x !in 0 until cw || y !in 0 until ch) return
+            val cell = y * cw + x
+            if (!exterior[cell] && !dark(left + x, top + y)) {
+                exterior[cell] = true; queue[count++] = cell
+            }
+        }
+        for (x in 0 until cw) { enqueue(x, 0); enqueue(x, ch - 1) }
+        for (y in 0 until ch) { enqueue(0, y); enqueue(cw - 1, y) }
+        while (head < count) {
+            val cell = queue[head++]
+            val x = cell % cw; val y = cell / cw
+            enqueue(x - 1, y); enqueue(x + 1, y); enqueue(x, y - 1); enqueue(x, y + 1)
+        }
+        var hole = 0
+        var whiteHole = 0
+        for (y in 0 until ch) for (x in 0 until cw) if (!exterior[y * cw + x] && !dark(left + x, top + y)) {
+            val p = pixels[(top + y) * width + left + x]
+            if (((p ushr 16) and 255) >= 200 && ((p ushr 8) and 255) >= 200 && (p and 255) >= 200) whiteHole++
+            hole++
+        }
+        if (hole < max(2, cw * ch / 12) || whiteHole < hole * 0.7f) return null
+        // Include only the same component's antialiased edge. If a pale bridge joins another glyph,
+        // reject it instead of erasing any body pixels. The bounding-box guard also rejects artwork.
+        val antialiased = component(250) ?: return null
+        if (antialiased.any {
+                val x = it % width; val y = it / width
+                x !in left - 2..right + 2 || y !in top - 2..bottom + 2 || (dark(x, y) && it !in coreSet)
+            }) return null
+        val gap = left - bodyRight - 1
+        val bodyEnd = if (gap >= max(2, height / 24)) (bodyRight + left + 1) / 2 else width
+        return Circle(bodyEnd, left, top, right, bottom, antialiased)
+    }
+
+    /** Retain every non-component pixel, including body strokes in overlapping columns. */
+    fun withoutCircle(pixels: IntArray, circle: Circle): IntArray = pixels.copyOf().also { body ->
+        for (index in circle.componentPixels) body[index] = -1
+    }
+
+    /** A second CTC pass must preserve every body character; never use a linguistic replacement. */
+    fun reconcile(original: String, body: String): String? {
+        if (body.isEmpty() || !original.startsWith(body)) return null
+        val tail = original.substring(body.length)
+        if (tail.codePointCount(0, tail.length) > 1) return null
+        return "$body。"
+    }
+}
