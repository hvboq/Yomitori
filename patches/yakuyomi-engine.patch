+        if (right >= width - 1) return null // Clipped marks are ambiguous.
+        val cw = right - left + 1
+        val ch = bottom - top + 1
+        if (cw < 4 || ch < 4 || cw > height * 0.42f || ch > height * 0.42f) return null
+        if (cw.toFloat() / ch !in 0.7f..1.4f || top < height * 0.52f || bottom >= height - 1) return null
