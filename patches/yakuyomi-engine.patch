+package li.joye.yakuyomi.engine
+
+import okhttp3.MediaType
+import okhttp3.Protocol
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.ResponseBody
+import okio.Buffer
+import okio.BufferedSource
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class BoundedHttpTest {
+    private fun response(text: String, code: Int = 200, knownLength: Boolean = true): Response {
+        val buffer = Buffer().writeUtf8(text)
+        val length = buffer.size
+        return Response.Builder().request(Request.Builder().url("https://example.test/models").build())
+            .protocol(Protocol.HTTP_1_1).code(code).message("fixture")
+            .body(object : ResponseBody() {
+                override fun contentType(): MediaType? = null
+                override fun contentLength() = if (knownLength) length else -1L
+                override fun source(): BufferedSource = buffer
+            }).build()
+    }
+
+    @Test fun acceptsExactLimitAndRejectsOversizedFixedAndChunkedBodies() {
+        val exact = "a".repeat(MAX_HTTP_RESPONSE_BYTES.toInt())
+        response(exact).use { assertEquals(exact, readBoundedResponse(it)) }
+        listOf(true, false).forEach { known ->
+            response(exact + "a", knownLength = known).use { response ->
+                assertThrows(IllegalArgumentException::class.java) { readBoundedResponse(response) }
+            }
+        }
+    }
+
+    @Test fun httpErrorRetainsRetryHintWithoutReflectedCredentials() {
+        response("reasoning unsupported; secret-api-key", 400).use { response ->
+            val error = assertThrows(HttpStatusFailure::class.java) { readBoundedResponse(response) }
+            assertTrue(error.thinkingRejected)
+            assertEquals("HTTP 400", safeHttpError(error))
+            assertFalse(error.toString().contains("secret"))
+        }
+    }
+
+    @Test fun parserAndUrlExceptionDetailsAreNotExposed() {
+        assertEquals("IllegalArgumentException", safeHttpError(IllegalArgumentException("secret-api-key")))
+    }
+}
