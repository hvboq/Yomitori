@@ -0,0 +1,14 @@
+package li.joye.yakuyomi.engine
+
+import kotlin.math.roundToInt
+
+/** Never commit a page whose complete translation cannot fit at a readable size. */
+internal fun fittingFontSize(minSize: Int, maxSize: Int, scale: Float, fits: (Int) -> Boolean): Int {
+    require(minSize > 0 && scale.isFinite() && scale > 0f) { "Invalid font configuration" }
+    for (candidate in maxSize downTo minSize) {
+        if (!fits(candidate)) continue
+        val scaled = (candidate * scale).roundToInt().coerceIn(minSize, maxSize)
+        if (fits(scaled)) return scaled
+    }
+    error("Translation does not fit its text region at the minimum font size")
+}
