+++ b/engine/src/main/kotlin/li/joye/yakuyomi/engine/BubbleReflow.kt
@@ -0,0 +1,92 @@
+package li.joye.yakuyomi.engine
+
+import kotlin.math.max
+import kotlin.math.min
+
+internal data class ReflowColumn(val index: Int, val bounds: PixelBounds, val text: String)
+internal data class ReflowArea(val members: Set<Int>, val bounds: PixelBounds, val text: String)
+
+/**
+ * Conservative horizontal reflow on an already cleaned page. No flood fill or inferred balloon
+ * contour: the source box and every pixel in the chosen rectangular band must be clear, and opaque
+ * boundaries must stop both horizontal searches. Three bounded, centred heights allow oval balloons
+ * to use their wider middle. Uncertain/art/dark/open backgrounds retain the original layout.
+ */
+internal fun planBubbleReflow(
+    columns: List<ReflowColumn>,
+    obstacles: Map<Int, PixelBounds>,
+    width: Int,
+    height: Int,
+    clear: (PixelBounds) -> Boolean,
+): List<ReflowArea> {
+    fun intersects(a: PixelBounds, b: PixelBounds) =
+        a.left < b.right && b.left < a.right && a.top < b.bottom && b.top < a.bottom
+    fun union(a: PixelBounds, b: PixelBounds) = PixelBounds(
+        min(a.left, b.left), min(a.top, b.top), max(a.right, b.right), max(a.bottom, b.bottom),
+    )
+    fun blocked(box: PixelBounds, members: Set<Int>) = obstacles.any { (index, other) ->
+        index !in members && intersects(box, other)
+    }
+    fun within(box: PixelBounds) = box.left >= 0 && box.top >= 0 && box.right <= width && box.bottom <= height
+    fun adjacent(a: PixelBounds, b: PixelBounds): Boolean {
+        val overlap = min(a.bottom, b.bottom) - max(a.top, b.top)
+        val gap = max(a.left, b.left) - min(a.right, b.right)
+        return overlap >= min(a.bottom - a.top, b.bottom - b.top) * 0.65f &&
+            gap >= 0 && gap <= max(a.width, b.width) * 1.5f &&
+            max(a.width, b.width) <= min(a.width, b.width) * 1.6f
+    }
+    val plans = ArrayList<ReflowArea>()
+    val consumed = HashSet<Int>()
+    for (seed in columns.sortedByDescending { it.bounds.right }) {
+        if (seed.index in consumed || !within(seed.bounds)) continue
+        val group = arrayListOf(seed)
+        var box = seed.bounds
+        // Small bounded groups prevent a chain of distant captions from becoming one paragraph.
+        while (group.size < 8) {
+            val next = columns.filter { it.index !in consumed && it !in group }
+                .sortedBy { kotlin.math.abs(it.bounds.left - box.left) }
+                .firstOrNull { candidate ->
+                    val joined = union(box, candidate.bounds)
+                    val members = group.map { it.index }.toSet() + candidate.index
+                    group.any { adjacent(it.bounds, candidate.bounds) } && within(joined) &&
+                        !blocked(joined, members) && clear(joined)
+                } ?: break
+            group.add(next)
+            box = union(box, next.bounds)
+        }
+        val members = group.map { it.index }.toSet()
+        if (blocked(box, members) || !clear(box)) continue
+        val limit = group.maxOf { it.bounds.width } * 4
+        val inset = (group.maxOf { it.bounds.width } / 8).coerceIn(8, 16)
+        val sourceHeight = box.bottom - box.top
+        val candidates = listOf(0, sourceHeight / 8, sourceHeight / 4).distinct().mapNotNull { trim ->
+            val band = PixelBounds(box.left, box.top + trim, box.right, box.bottom - trim)
+            var left = band.left
+            var right = band.right
+            var leftWall = false
+            var rightWall = false
+            while (left > 0 && band.left - left < limit) {
+                val strip = PixelBounds(left - 1, band.top, left, band.bottom)
+                if (blocked(strip, members)) break
+                if (!clear(strip)) { leftWall = true; break }
+                left--
+            }
+            while (right < width && right - band.right < limit) {
+                val strip = PixelBounds(right, band.top, right + 1, band.bottom)
+                if (blocked(strip, members)) break
+                if (!clear(strip)) { rightWall = true; break }
+                right++
+            }
+            if (!leftWall || !rightWall) return@mapNotNull null
+            val area = PixelBounds(left + inset, band.top + inset, right - inset, band.bottom - inset)
+            if (area.width < group.maxOf { it.bounds.width } * 1.5f || area.bottom <= area.top ||
+                blocked(area, members) || plans.any { intersects(it.bounds, area) } || !clear(area)
+            ) null else area
+        }
+        // Prefer usable horizontal room; equal-width rectangles retain their full original height.
+        val area = candidates.maxWithOrNull(compareBy<PixelBounds> { it.width }.thenBy { it.bottom - it.top }) ?: continue
+        plans.add(ReflowArea(members, area, group.sortedByDescending { it.bounds.right }.joinToString(" ") { it.text }))
+        consumed.addAll(members)
+    }
+    return plans
+}
