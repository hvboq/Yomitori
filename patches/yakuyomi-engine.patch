+++ b/engine/src/main/kotlin/li/joye/yakuyomi/engine/TranslationResponseParser.kt
@@ -0,0 +1,41 @@
+package li.joye.yakuyomi.engine
+
+/** A response is usable only if every requested ID occurs exactly once with nonempty text. */
+internal object TranslationResponseParser {
+    private val marker = Regex("""<\|(\d+)\|>""")
+    private val fenced = Regex("""```(?:text|plaintext)?[\t ]*\r?\n([\s\S]*?)\r?\n```""")
+    private val fenceLine = Regex("""(?m)^[\t ]*```""")
+
+    fun parse(raw: String, count: Int): List<String> {
+        require(count > 0) { "Expected a positive translation count" }
+        var text = raw.trim()
+        // Only a leading reasoning block is metadata. Never silently delete text inside a region.
+        if (text.startsWith("<think>")) {
+            val end = text.indexOf("</think>")
+            require(end >= 0 && "<think>" !in text.substring(7, end)) { "Invalid reasoning block" }
+            text = text.substring(end + 8).trim()
+        }
+        require("<think>" !in text && "</think>" !in text) { "Incomplete reasoning block" }
+        // Some compatible models wrap otherwise valid translations. Remove one whole wrapper only;
+        // prefixes, multiple fences and partial fences still fail exact-ID validation below.
+        text = fenced.matchEntire(text)?.groupValues?.get(1)?.trim() ?: text
+        require(!fenceLine.containsMatchIn(text)) { "Unexpected code fence" }
+        val matches = marker.findAll(text).toList()
+        require(matches.size == count) { "Expected $count translations, received ${matches.size}" }
+        require(matches.isNotEmpty() && text.substring(0, matches.first().range.first).isBlank()) {
+            "Unexpected text before translation IDs"
+        }
+        val values = mutableMapOf<Int, String>()
+        matches.forEachIndexed { index, match ->
+            val id = match.groupValues[1].toIntOrNull()
+            require(id != null && id.toString() == match.groupValues[1] && id in 1..count && id !in values) {
+                "Invalid or duplicate translation ID"
+            }
+            val end = matches.getOrNull(index + 1)?.range?.first ?: text.length
+            val value = text.substring(match.range.last + 1, end).trim()
+            require(value.isNotBlank() && "<|" !in value) { "Empty translation or malformed ID" }
+            values[id] = value
+        }
+        return (1..count).map { values.getValue(it) }
+    }
+}
