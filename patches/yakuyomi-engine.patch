@@ -0,0 +1,72 @@
+package li.joye.yakuyomi.engine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+class TranslationResponseParserTest {
+    @Test fun alignsReorderedIds() {
+        assertEquals(listOf("one", "two"), TranslationResponseParser.parse("<|2|>two\n<|1|>one", 2))
+    }
+
+    @Test fun keepsMultilineTextAndSeparatesSameLineIds() {
+        assertEquals(listOf("first\ncontinued", "second"), TranslationResponseParser.parse("<|1|>first\ncontinued <|2|>second", 2))
+    }
+
+    @Test fun removesCompleteThinkingBlock() {
+        assertEquals(listOf("translated"), TranslationResponseParser.parse("<think>reasoning</think>\n<|1|>translated", 1))
+    }
+
+    @Test fun acceptsOnlyCompletePlainTextWrappersAndStillAlignsIds() {
+        for (language in listOf("", "text", "plaintext")) {
+            val raw = "<think>reasoning</think>\n```$language\r\n<|2|>둘\r\n<|1|>하나\r\n```"
+            assertEquals(listOf("하나", "둘"), TranslationResponseParser.parse(raw, 2))
+        }
+    }
+
+    @Test fun rejectsWrappersThatHideMissingDuplicateOrUnexpectedIds() {
+        for (body in listOf("<|1|>one", "<|1|>one\n<|1|>two", "<|1|>one\n<|9|>two")) {
+            assertThrows(IllegalArgumentException::class.java) {
+                TranslationResponseParser.parse("```text\n$body\n```", 2)
+            }
+        }
+    }
+
+    @Test fun rejectsPartialMultipleAndCommentedWrappers() {
+        for (raw in listOf(
+            "```\n<|1|>one",
+            "<|1|>one\n```",
+            "Here it is:\n```\n<|1|>one\n```",
+            "```\n<|1|>one\n```\ncommentary",
+            "```\n<|1|>one\n```\n```\n<|2|>two\n```",
+        )) {
+            assertThrows(IllegalArgumentException::class.java) { TranslationResponseParser.parse(raw, 1) }
+        }
+    }
+
+    @Test fun neverDeletesReasoningMarkupInsideATranslatedRegion() {
+        for (raw in listOf(
+            "<|1|>first<think>text</think>last",
+            "<think>outer<think>inner</think></think><|1|>one",
+            "<think>one</think><think>two</think><|1|>one",
+            "<|01|>one",
+        )) {
+            assertThrows(IllegalArgumentException::class.java) { TranslationResponseParser.parse(raw, 1) }
+        }
+    }
+
+    @Test fun rejectsMissingUnexpectedDuplicateEmptyAndMalformedIds() {
+        listOf(
+            "<|1|>one",
+            "<|1|>one\n<|99|>two",
+            "<|1|>one\n<|1|>two",
+            "<|1|>one\n<|2|>   ",
+            "<|0|>zero\n<|2|>two",
+            "<|1|>one\n<|2>two",
+            "preamble\n<|1|>one\n<|2|>two",
+            "<think>unfinished <|1|>one\n<|2|>two",
+        ).forEach { raw ->
+            assertThrows(raw, IllegalArgumentException::class.java) { TranslationResponseParser.parse(raw, 2) }
+        }
+    }
+}
diff --git a/engine/src/test/kotlin/li/joye/yakuyomi/engine/TranslationRetryTest.kt b/engine/src/test/kotlin/li/joye/yakuyomi/engine/TranslationRetryTest.kt
new file mode 100644
index 0000000..e80e27e
--- /dev/null
+++ b/engine/src/test/kotlin/li/joye/yakuyomi/engine/TranslationRetryTest.kt
@@ -0,0 +1,83 @@
+package li.joye.yakuyomi.engine
+
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertThrows
+import org.junit.Test
+import java.io.IOException
+
+class TranslationRetryTest {
+    @Test fun transientGatewayResponseRetriesTheSameRequestOnce() = runBlocking {
+        for (status in listOf(502, 503, 504)) {
+            var attempts = 0
+            val result = retryTransientTranslationRequest {
+                attempts++
+                if (attempts == 1) throw HttpStatusFailure(status, false)
+                "translated page"
+            }
+            assertEquals("translated page", result)
+            assertEquals(2, attempts)
+        }
+    }
+
+    @Test fun persistentGatewayFailureStopsAfterOneRetry() {
+        var attempts = 0
+        val error = assertThrows(HttpStatusFailure::class.java) {
+            runBlocking {
+                retryTransientTranslationRequest {
+                    attempts++
+                    throw HttpStatusFailure(502, false)
+                }
+            }
+        }
+        assertEquals(502, error.status)
+        assertEquals(2, attempts)
+    }
+
+    @Test fun authenticationRateLimitAndOtherHttpErrorsAreNotRetried() {
+        for (status in listOf(400, 401, 403, 404, 408, 429, 500)) {
+            var attempts = 0
+            assertThrows(HttpStatusFailure::class.java) {
+                runBlocking {
+                    retryTransientTranslationRequest {
+                        attempts++
+                        throw HttpStatusFailure(status, false)
+                    }
+                }
+            }
+            assertEquals(1, attempts)
+        }
+    }
+
+    @Test fun ambiguousIoAndInvalidResponsesAreNotRetried() {
+        for (failure in listOf(IOException("transport"), IllegalArgumentException("response"))) {
+            var attempts = 0
+            val actual = assertThrows(Exception::class.java) {
+                runBlocking {
+                    retryTransientTranslationRequest {
+                        attempts++
+                        throw failure
+                    }
+                }
+            }
+            assertSame(failure, actual)
+            assertEquals(1, attempts)
+        }
+    }
+
+    @Test fun cancellationDuringBackoffPreventsAnotherRequest() = runBlocking {
+        var attempts = 0
+        val job = launch(start = CoroutineStart.UNDISPATCHED) {
+            retryTransientTranslationRequest {
+                attempts++
+                throw HttpStatusFailure(503, false)
+            }
+        }
+        job.cancelAndJoin()
+        assertEquals(1, attempts)
+    }
+}
diff --git a/inference-core/src/test/kotlin/li/joye/yakuyomi/engine/ImageOpsMemoryParityTest.kt b/inference-core/src/test/kotlin/li/joye/yakuyomi/engine/ImageOpsMemoryParityTest.kt
new file mode 100644
index 0000000..d4f11b0
--- /dev/null
+++ b/inference-core/src/test/kotlin/li/joye/yakuyomi/engine/ImageOpsMemoryParityTest.kt
@@ -0,0 +1,56 @@
+package li.joye.yakuyomi.engine
+
+import kotlin.math.roundToInt
+import kotlin.random.Random
+import org.junit.Assert.assertArrayEquals
+import org.junit.Test
+
+class ImageOpsMemoryParityTest {
+    @Test
+    fun reusedScratchPlanesMatchOriginalUnsharpIncludingAlphaAndPadding() {
+        val random = Random(481)
+        for ((w, h) in listOf(1 to 1, 1 to 17, 19 to 1, 3 to 5, 31 to 27)) {
+            val stride = w + 7
+            for (amount in listOf(0f, 0.5f, 1.5f, 3f)) {
+                val input = IntArray(stride * (h + 3)) { random.nextInt() }
+                val expected = originalUnsharp(input.copyOf(), stride, w, h, amount)
+                val actual = input.copyOf()
+                val method = ImageOps::class.java.getDeclaredMethod(
+                    "unsharp", IntArray::class.java, Int::class.javaPrimitiveType,
+                    Int::class.javaPrimitiveType, Int::class.javaPrimitiveType, Float::class.javaPrimitiveType,
+                ).apply { isAccessible = true }
+                method.invoke(ImageOps, actual, stride, w, h, amount)
+                assertArrayEquals("${w}x$h amount=$amount", expected, actual)
+            }
+        }
+    }
+
+    // Independent snapshot of the previous three-plane/channel implementation. This checks exact
+    // pixel parity, including edge replication, Float rounding, alpha and unused padded rows/columns.
+    private fun originalUnsharp(px: IntArray, stride: Int, nw: Int, nh: Int, amount: Float): IntArray {
+        val weights = floatArrayOf(0.02763f, 0.06630f, 0.12383f, 0.18018f, 0.20416f, 0.18018f, 0.12383f, 0.06630f, 0.02763f)
+        for (shift in listOf(16, 8, 0)) {
+            val orig = FloatArray(nw * nh)
+            val tmp = FloatArray(nw * nh)
+            val blur = FloatArray(nw * nh)
+            for (y in 0 until nh) for (x in 0 until nw) orig[y * nw + x] = ((px[y * stride + x] shr shift) and 0xFF).toFloat()
+            for (y in 0 until nh) for (x in 0 until nw) {
+                var sum = 0f
+                for (k in -4..4) sum += orig[y * nw + (x + k).coerceIn(0, nw - 1)] * weights[k + 4]
+                tmp[y * nw + x] = sum
+            }
+            for (y in 0 until nh) for (x in 0 until nw) {
+                var sum = 0f
+                for (k in -4..4) sum += tmp[(y + k).coerceIn(0, nh - 1) * nw + x] * weights[k + 4]
+                blur[y * nw + x] = sum
+            }
+            for (y in 0 until nh) for (x in 0 until nw) {
+                val i = y * nw + x
+                val value = (orig[i] + amount * (orig[i] - blur[i])).roundToInt().coerceIn(0, 255)
+                val dest = y * stride + x
+                px[dest] = (px[dest] and (0xFF shl shift).inv()) or (value shl shift)
+            }
+        }
+        return px
+    }
+}
