+package li.joye.yakuyomi.engine
+
+import kotlin.math.ceil
+import kotlin.math.floor
+
+/** Half-open pixel bounds shared by removal masks and render collision checks. */
+internal data class PixelBounds(val left: Int, val top: Int, val right: Int, val bottom: Int) {
+    val width: Int get() = right - left
+}
+
+internal fun protectedRegionBounds(regions: List<TextRegion>, width: Int, height: Int): List<PixelBounds> =
+    regions.filter { it.preserveOriginal }.mapNotNull { region ->
+        val bounds = PixelBounds(
+            floor(region.x0).toInt().coerceIn(0, width),
+            floor(region.y0).toInt().coerceIn(0, height),
+            ceil(region.x1).toInt().coerceIn(0, width),
+            ceil(region.y1).toInt().coerceIn(0, height),
+        )
+        bounds.takeIf { it.left < it.right && it.top < it.bottom }
+    }
+
+internal fun clearProtectedMask(mask: IntArray, width: Int, bounds: List<PixelBounds>) {
+    bounds.forEach { box ->
+        for (y in box.top until box.bottom) {
+            mask.fill(0xFF000000.toInt(), y * width + box.left, y * width + box.right)
+        }
+    }
+}
