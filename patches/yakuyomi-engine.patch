@@ -0,0 +1,109 @@
+package li.joye.yakuyomi.engine
+
+import kotlinx.coroutines.runBlocking
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Response
+import okhttp3.ResponseBody
+import okhttp3.ResponseBody.Companion.toResponseBody
+import okio.Buffer
+import org.junit.Assert.*
+import org.junit.Test
+import java.nio.file.Files
+import java.security.MessageDigest
+
+class ModelDownloaderTest {
+    private fun model(bytes: ByteArray) = RemoteModel(
+        "ocr", "ocr.bin", "https://models.example/ocr.bin", bytes.size.toLong(),
+        MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) },
+    )
+
+    private fun client(body: () -> ResponseBody) = OkHttpClient.Builder().addInterceptor { chain ->
+        Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1)
+            .code(200).message("OK").body(body()).build()
+    }.build()
+
+    private fun unknownLength(bytes: ByteArray) = object : ResponseBody() {
+        private val data = Buffer().write(bytes)
+        override fun contentType() = null
+        override fun contentLength() = -1L
+        override fun source() = data
+    }
+
+    @Test fun rejectsUnsafeMetadataBeforeNetworkOrFileMutation() = runBlocking {
+        val valid = model(byteArrayOf(1, 2, 3))
+        val invalid = listOf(
+            valid.copy(name = "../escape.bin"), valid.copy(name = "a/b.bin"),
+            valid.copy(name = "a\\b.bin"), valid.copy(name = "/absolute.bin"),
+            valid.copy(size = 0), valid.copy(size = Long.MAX_VALUE), valid.copy(sha256 = "bad"),
+            valid.copy(url = "http://models.example/ocr.bin"),
+            valid.copy(url = "https://secret@models.example/ocr.bin"),
+        )
+        invalid.forEach { candidate ->
+            assertThrows(IllegalArgumentException::class.java) { ModelDownloader.validateModels(listOf(candidate)) }
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            ModelDownloader.validateModels(listOf(valid, valid.copy(name = "OCR.BIN")))
+        }
+        ModelDownloader.validateModels(listOf(valid))
+    }
+
+    @Test fun corruptedResponsePreservesPreviousModel() = verifyRejected(byteArrayOf(7, 7, 7), false)
+
+    @Test fun oversizedUnknownLengthResponsePreservesPreviousModel() = verifyRejected(byteArrayOf(1, 2, 3, 4), true)
+
+    @Test fun truncatedUnknownLengthResponsePreservesPreviousModel() = verifyRejected(byteArrayOf(1), true)
+
+    private fun verifyRejected(bytes: ByteArray, chunked: Boolean) = runBlocking {
+        val dir = Files.createTempDirectory("model-download").toFile()
+        val target = dir.resolve("ocr.bin").apply { writeBytes(byteArrayOf(9, 8)) }
+        val http = client { if (chunked) unknownLength(bytes) else bytes.toResponseBody() }
+        try {
+            try {
+                ModelDownloader.ensure(listOf(model(byteArrayOf(1, 2, 3))), dir, http)
+                fail("Invalid response must fail")
+            } catch (_: IllegalArgumentException) {
+                assertArrayEquals(byteArrayOf(9, 8), target.readBytes())
+                assertEquals(listOf("ocr.bin"), dir.list()!!.toList())
+            }
+        } finally {
+            dir.deleteRecursively()
+            http.dispatcher.executorService.shutdown()
+            http.connectionPool.evictAll()
+        }
+    }
+
+    @Test fun verifiedResponseReplacesOldModelAndNextCallSkipsNetwork() = runBlocking {
+        val dir = Files.createTempDirectory("model-download").toFile()
+        val bytes = byteArrayOf(1, 2, 3)
+        val target = dir.resolve("ocr.bin").apply { writeBytes(byteArrayOf(9, 8)) }
+        var requests = 0
+        val http = client { requests++; unknownLength(bytes) }
+        try {
+            ModelDownloader.ensure(listOf(model(bytes)), dir, http)
+            assertArrayEquals(bytes, target.readBytes())
+            ModelDownloader.ensure(listOf(model(bytes)), dir, http)
+            assertEquals(1, requests)
+            assertEquals(listOf("ocr.bin"), dir.list()!!.toList())
+        } finally {
+            dir.deleteRecursively()
+            http.dispatcher.executorService.shutdown()
+            http.connectionPool.evictAll()
+        }
+    }
+
+    @Test fun manifestResponseSizeIsBoundedBeforeJsonParsing() = runBlocking {
+        val http = client { unknownLength(ByteArray(1024 * 1024 + 1)) }
+        try {
+            try {
+                ModelDownloader.fetchManifest("https://models.example/manifest.json", http)
+                fail("Oversized manifest must fail")
+            } catch (error: IllegalArgumentException) {
+                assertEquals("Model manifest too large", error.message)
+            }
+        } finally {
+            http.dispatcher.executorService.shutdown()
+            http.connectionPool.evictAll()
+        }
+    }
+}
