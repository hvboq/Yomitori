+package li.joye.yakuyomi.engine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ProtectedRegionsTest {
+    private fun region(left: Float, top: Float, right: Float, bottom: Float, protect: Boolean) =
+        TextRegion(listOf(TextLine(listOf(Pt(left, top), Pt(right, top), Pt(right, bottom), Pt(left, bottom)), 1f)), "h")
+            .apply { preserveOriginal = protect }
+
+    @Test fun boundsCoverFractionalEdgesAndClampToPage() {
+        val regions = listOf(region(-1.2f, 2.3f, 5.1f, 12f, true), region(1f, 1f, 4f, 4f, false))
+        assertEquals(listOf(PixelBounds(0, 2, 6, 10)), protectedRegionBounds(regions, 10, 10))
+    }
+
+    @Test fun offPageProtectedRegionsHaveNoPixels() {
+        assertTrue(protectedRegionBounds(listOf(region(11f, 1f, 15f, 5f, true)), 10, 10).isEmpty())
+    }
+
+    @Test fun removesProtectedPixelsFromDilatedMaskWithoutTouchingNeighbor() {
+        val mask = IntArray(100) { -1 }
+        clearProtectedMask(mask, 10, listOf(PixelBounds(2, 2, 5, 5)))
+        for (y in 0 until 10) for (x in 0 until 10) {
+            assertEquals(if (x in 2..4 && y in 2..4) 0xFF000000.toInt() else -1, mask[y * 10 + x])
+        }
+    }
+}
