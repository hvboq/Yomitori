+package li.joye.yakuyomi.engine
+
+/** Owns partially constructed native components until their aggregate takes ownership. */
+internal class ConstructionResources : AutoCloseable {
+    private val resources = mutableListOf<AutoCloseable>()
+
+    fun <T : AutoCloseable> own(resource: T): T = resource.also { resources.add(it) }
+
+    fun transfer() = resources.clear()
+
+    override fun close() {
+        resources.asReversed().forEach { runCatching { it.close() } }
+        resources.clear()
+    }
+}
